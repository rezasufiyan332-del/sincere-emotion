# ============================================
# SINCERE EMOTION - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in values

# ------------------------------------------
# DATABASE (Neon PostgreSQL)
# ------------------------------------------
DATABASE_URL=          # Pooled connection: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.amazonaws.com/dbname?sslmode=require
DIRECT_URL=            # Direct connection: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.amazonaws.com/dbname?sslmode=require

# ------------------------------------------
# STRIPE (https://dashboard.stripe.com)
# ------------------------------------------
STRIPE_SECRET_KEY=              # sk_test_... (production: sk_live_...)
STRIPE_WEBHOOK_SECRET=          # whsec_... (from Stripe webhook settings)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # pk_test_... (production: pk_live_...)

# ------------------------------------------
# EMAIL (Resend - https://resend.com)
# ------------------------------------------
RESEND_API_KEY=                # re_...
EMAIL_FROM=                    # Optional: "Sincere Emotion <noreply@yourdomain.com>"

# ------------------------------------------
# AUTH (NextAuth.js)
# ------------------------------------------
AUTH_SECRET=                   # Generate: openssl rand -base64 32
GOOGLE_CLIENT_ID=              # From Google Cloud Console
GOOGLE_CLIENT_SECRET=          # From Google Cloud Console

# ------------------------------------------
# APP URLs
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000     # Production: https://yourdomain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000    # Production: https://yourdomain.com

# ------------------------------------------
# OPTIONAL: Upstash Redis (for rate limiting)
# ------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------
# OPTIONAL: Sentry (for error tracking)
# ------------------------------------------
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
