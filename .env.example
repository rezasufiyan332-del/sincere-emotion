# ============================================
# SINCERE EMOTION - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in values

# ------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------
DATABASE_URL=          # postgresql://user:pass@hostname:5432/dbname?sslmode=require
DIRECT_URL=            # Direct connection (optional, for migrations)

# ------------------------------------------
# RAZORPAY (https://dashboard.razorpay.com)
# ------------------------------------------
RAZORPAY_KEY_ID=              # rzp_test_... (production: rzp_live_...)
RAZORPAY_KEY_SECRET=          # ... (from Razorpay settings)
RAZORPAY_WEBHOOK_SECRET=      # ... (from Razorpay webhook settings)
NEXT_PUBLIC_RAZORPAY_KEY_ID=  # rzp_test_... (same as RAZORPAY_KEY_ID)

# ------------------------------------------
# EMAIL (Resend - https://resend.com)
# ------------------------------------------
RESEND_API_KEY=                # re_...
EMAIL_FROM=                    # "Sincere Emotion <noreply@yourdomain.com>"

# ------------------------------------------
# AUTH (NextAuth.js)
# ------------------------------------------
AUTH_SECRET=                   # Generate: openssl rand -base64 32
GOOGLE_CLIENT_ID=              # Optional: From Google Cloud Console
GOOGLE_CLIENT_SECRET=          # Optional: From Google Cloud Console

# ------------------------------------------
# APP URLs
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000     # Production: https://yourdomain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000    # Production: https://yourdomain.com

# ------------------------------------------
# OPTIONAL: Upstash Redis (for rate limiting)
# ------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
